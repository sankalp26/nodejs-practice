<div class="container mt-5">
  <div class="card shadow-sm p-4">
    <h3 class="mb-4">Update Product</h3>
    <% if(errorMessage){ %>
      <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
    <% } %>
    

    <form action="/update-product" method="POST">
<!-- id -->
        <div class="mb-3">
        <input
          type="hidden"
          class="form-control"
          name="id"
          placeholder=""
          value="<%=product.id%>"
        />
      </div>
      <!-- Name -->
      <div class="mb-3">
        <label class="form-label">Product Name</label>
        <input
          type="text"
          class="form-control"
          name="name"
          placeholder="Enter product name"
          value="<%=product.name%>"
          required
        />
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          class="form-control"
          name="desc"
          rows="3"
          placeholder="Enter description"
          
          required
        ><%=product.desc%></textarea>
      </div>

      <!-- Price -->
      <div class="mb-3">
        <label class="form-label">Price (₹)</label>
        <input
          type="number"
          class="form-control"
          name="price"
          placeholder="Enter price"
          value="<%=product.price%>"
          required
        />
      </div>

      <!-- Image URL -->
      <div class="mb-3">
        <label class="form-label">Image URL</label>
        <input
          type="file"
          class="form-control"
          name="imgUrl"
          
          value=""
          required
        />
      </div>

      <!-- Submit button -->
      <button type="submit" class="btn btn-primary">Update Product</button>
    </form>
  </div>
</div>
